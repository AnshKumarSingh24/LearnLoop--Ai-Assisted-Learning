# ==========================================
# CAPTURE — Context Intelligence Platform
# Environment Configuration Template
# ==========================================

# Optional: Groq enables AI-synthesized toolkit output and answers.
# Without a key, document tools use a source-only mode with citations.
# Copy this template to the backend working directory's .env and add your key.
# Never commit a populated .env file.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (default: openai/gpt-oss-20b or llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Configuration (Optional - Local SQLite/In-Memory DB runs automatically if blank)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
